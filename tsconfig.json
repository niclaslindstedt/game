{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "react-dom/client": ["./node_modules/preact/compat/client.d.ts"],
      "react-dom": ["./node_modules/preact/compat"],
      "react": ["./node_modules/preact/compat"],
      "@game/core": ["./engine/index.ts"],
      "@game/menu": ["./engine/menu.ts"],
      "@game/lib/*": ["./engine/lib/*"],
      "@game/wire/*": ["./server/wire/*"],
      "@game/client": ["./server/client.ts"],
      "@ui/lib/*": ["./pwa/src/lib/*"]
    }
  },
  "include": [
    "engine",
    "server",
    "tests",
    "vitest.config.ts",
    "pwa/src/build-globals.d.ts",
    "pwa/src/vite-env.d.ts"
  ]
}
