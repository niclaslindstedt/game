{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Adas Trail",
  "mainBinaryName": "adastrail",
  "version": "0.1.0",
  "identifier": "se.niclaslindstedt.adastrail.tauri",
  "build": {
    "frontendDist": "./placeholder"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png"
    ],
    "resources": {
      "../webroot": "webroot"
    },
    "externalBin": [],
    "category": "Game",
    "shortDescription": "survive the search for your lost love",
    "longDescription": "Ada went out for a midnight walk and never came back — the trail leads to the moon. Fight your way to her and bring her home.",
    "copyright": "Copyright © Niclas Lindstedt",
    "macOS": {
      "entitlements": "entitlements.mac.plist",
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
