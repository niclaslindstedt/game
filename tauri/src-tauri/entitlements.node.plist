<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0

  Hardened-runtime entitlements for the BUNDLED NODE RUNTIME only — the
  session server and the mod toolchain run under it — applied by
  `scripts/package.mjs` when it signs that binary with a real Developer ID.
  (An ad-hoc signature carries no hardened runtime, so it needs none.)

  The app's own list (`entitlements.mac.plist`) deliberately leaves the JIT
  entitlements out, because WKWebView runs its JavaScript out of process.
  Node is the opposite case: V8 compiles JavaScript into executable memory IN
  this process, and under the hardened runtime that is refused without both
  entries below — the server would be killed the moment it started. Node's own
  release binaries carry the same pair; re-signing replaces them, so they are
  restated here.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
