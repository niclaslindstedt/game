# Build artifacts — regenerated, never committed (OSS_SPEC §11.2).

# The built website, copied in by scripts/bundle-web.mjs. It is the pwa/ build
# output; committing it would duplicate the whole site in the history.
webroot/

# Cargo's build output for this workspace.
target/

# The app icon, re-encoded to RGBA from pwa/public/ by scripts/icons.mjs —
# Tauri refuses a paletted PNG at compile time and every icon the website ships
# is paletted. The ART is pwa/public/; these are a format conversion of it.
src-tauri/icons/

# Tauri's generated permission schemas — written by tauri-build on every
# compile, and what capabilities/*.json is validated against.
src-tauri/gen/

# The packaged output — the Steam depot directory that scripts/package.mjs
# assembles. The peer of electron/release/.
release/

# This tree has its OWN dependency tree — it is not an npm workspace member.
# Today it holds one thing: the Tauri CLI, which is what packages a build.
node_modules/

# The local dev app id (Valve's Spacewar, 480). Written by hand when running
# against a local Steam client; never part of a build.
steam_appid.txt

# Cargo.lock IS committed (this tree builds binaries, not a library), so it is
# deliberately absent from this file. So is package-lock.json, for the same
# reason electron/'s is committed: a packaging run has to be reproducible.
