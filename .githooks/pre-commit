#!/usr/bin/env bash
# SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
# Pre-commit hook. Install once with `make hooks`.
#
# Fast checks only: formatting and the CHANGELOG guard. Lint, typecheck and the
# suite stay at the commit gate and in CI — each opens by rebuilding the whole
# content tree, and a hook that takes minutes gets bypassed.
set -euo pipefail

# Formatting — the same check CI's `format` job runs.
npm run --silent fmt:check || {
  echo ""
  echo "pre-commit: formatting check failed — run 'make fmt' and re-stage."
  exit 1
}

# CHANGELOG.md is written by the release workflow from the .changes/unreleased/
# fragments; a hand edit is overwritten and breaks the collation. The release
# commit itself sets ALLOW_CHANGELOG_EDIT=1.
if git diff --cached --name-only | grep -qx "CHANGELOG.md"; then
  if [ "${ALLOW_CHANGELOG_EDIT:-}" != "1" ]; then
    echo ""
    echo "pre-commit: CHANGELOG.md is generated by the release workflow."
    echo "Add a fragment under .changes/unreleased/ instead (the changelog skill)."
    echo "A release commit may bypass with ALLOW_CHANGELOG_EDIT=1."
    exit 1
  fi
fi
