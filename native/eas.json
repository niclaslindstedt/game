{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "24.21.0",
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true }
    },
    "preview": {
      "node": "24.21.0",
      "distribution": "internal",
      "autoIncrement": true,
      "android": { "buildType": "apk" }
    },
    "testflight": {
      "node": "24.21.0",
      "autoIncrement": true
    },
    "production": {
      "node": "24.21.0",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_STORE_PAYMENTS": "required"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "metadataPath": "./store/store.config.json",
        "ascAppId": "6805189168",
        "appleTeamId": "8Z7JSMA9SB",
        "ascApiKeyId": "$ASC_KEY_ID",
        "ascApiKeyIssuerId": "$ASC_ISSUER_ID",
        "ascApiKeyPath": "$ASC_KEY_PATH"
      }
    }
  }
}
