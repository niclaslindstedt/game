# Which app fastlane is talking about. The bundle id is the one source of truth
# in app.config.js — kept in step by `fastlane metadata`'s preflight, which
# fails if the two drift.
app_identifier("se.niclaslindstedt.goneinspace")

# Both come from the environment rather than the repo: the Apple Account email
# is personal data and the team id is account-shaped, and neither belongs in a
# public tree. Set them in native/.env (gitignored) or the shell.
apple_id(ENV["APPLE_ID"])
itc_team_id(ENV["ASC_TEAM_ID"])
team_id(ENV["APPLE_TEAM_ID"])
