# ── BREAK — the clock, a re-struck pedal, and the siren. Nothing else ──────
section break
  chords Dm | Dm | Eb | Eb | Gm | Gm | A | A
  siren  .*16 | a4*8 a4*8 | .*16 | a#4*8 a#4*8
         .*16 | d5*8 d5*8 | .*16 | c#5*8 e5*8
  stab   arp:4 | arp:4 | arp:4 | arp:4
         arp:3 | arp:3 | arp:3 | arp:3
  bass   d2*8 d2*8 | d2*8 d2*8 | d#2*8 d#2*8 | d#2*8 d#2*8
         g2*8 g2*8 | g2*8 g2*8 | a2*8 a2*8 | a2*8 a2*8
  hat    x.......x.....x.
  tick   x...x...x...x...

