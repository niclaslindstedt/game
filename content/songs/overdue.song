         d5*2 e5*2 f5*2 g5*2 a5*4 d5*4 | f5*2 d5*2 a#4*2 d5*2 f5*2 a5*2 a#5*4 | a5*2 g5*2 e5*2 c5*2 e5*2 g5*2 a5*4 | a5*2 g5*2 f5*2 e5*2 c#5*4 a4*4
  siren  a5*8 a5*8 | a#5*8 a#5*8 | a5*8 a5*8 | a#5*8 a#5*8
