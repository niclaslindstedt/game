# Common
.DS_Store
*.log
*.tmp
.env
.env.local

# Editors
.vscode/
.idea/
*.swp

# Coverage
.coverage/
coverage/

# Website
pwa/node_modules/
pwa/dist/
pwa/src/generated/
# Generated engine level catalog — source of truth is
# scripts/levels/*.yaml; regenerated via `npm run levels` (§11.2).
src/generated/
# Generated pixel-asset atlases (sprite + font) — source of truth is
# scripts/sprites/; regenerated on every build via `npm run assets` (§11.2).
pwa/src/game/assets/
# Sprite previews for the pixel-assets iteration loop (regenerate on demand)
pwa/assets-preview/

# Generated docs
docs/_build/

# The engine's Node ship target: the staged sources and the compiled server
# (scripts/build-server.mjs). Build output like src/generated/ — regenerated on
# every desktop build, never committed.
electron/server-src/
electron/server-dist/
electron/webroot/
electron/dist/
electron/release/
electron/node_modules/

# The Tauri desktop shell (docs/tauri-migration.md). Same shape as electron/'s
# above: the copied website, Cargo's output, the RGBA re-encode of the app icon
# (the ART is pwa/public/), and Tauri's generated permission schemas.
tauri/webroot/
tauri/target/
tauri/src-tauri/icons/
tauri/src-tauri/gen/
tauri/node_modules/
tauri/release/
tauri/resources/

# Node
node_modules/
dist/
.next/
.turbo/

# Pages artifact staging
site/
site-*/

# TypeScript
*.tsbuildinfo

# progression-sim default output (scripts/progression-sim.mjs)
progression.html
progression.json

# mob-hp-curve default output (scripts/mob-hp-curve.mjs) — the hits-to-kill
# graph, regenerated on every balance probe like its progression-sim sibling.
mob-hp-curve.html

# Store submission build outputs (§11.2 — the YAML/recipes are the source of
# truth, these are regenerated). `make store-metadata` compiles the listing;
# `make store-shots` captures the screenshot set; `make store-achievement-art`
# cuts the portals' badge artwork out of the game's own sprite atlas.
native/store/store.config.json
native/store/screenshots/
native/store/achievements/
electron/store/screenshots/
electron/store/achievements/
electron/store/preview/output/

# fastlane: the metadata tree and staged screenshots are GENERATED from
# native/store/listing.yaml + native/store/screenshots by `npm run store:stage`
# — listing.yaml is the source of truth, never these. The rest is fastlane's own
# run output and local credentials, which must never be committed.
native/fastlane/metadata/
native/fastlane/screenshots/
native/fastlane/report.xml
native/fastlane/Preview.html
native/fastlane/test_output/
native/.env
native/*.p8

# The library's generated social cards and search shots — a deploy-time
# artifact restored from an Actions cache, never committed (~35 MB a set).
.library-images/

# Agent scratch worktrees — parallel sessions' clones of this repo, never
# content of it (eslint ignores the same path).
.claude/worktrees/

# Local agent runtime metadata. The canonical checked-in playbooks live under
# `.agent/`; these plural/runtime directories are materialized by coding tools.
.agents/
.codex/

# The Lua VM compiled for the SHIPPED mod compiler (scripts/build-lua.mjs) — the
# desktop shell's main process has no TypeScript, so the validator reads this
# instead of src/lib/lua/. It sits beside server-dist/ rather than under mod/,
# which is licence-split territory. Build output like src/generated/;
# regenerated, never committed.
electron/modtools-lua/
electron/tsconfig.modtools-lua.json
