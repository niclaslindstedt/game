{
  "name": "game",
  "version": "1.0.0",
  "private": true,
  "description": "Offline top-down survival scroller shooter for the browser: steer by holding pointer/touch; the character auto-acts based on picked-up weapons and items. TypeScript PWA deployed to GitHub Pages.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Niclas Lindstedt <niclas@agilator.se>",
  "type": "module",
  "workspaces": [
    "pwa"
  ],
  "scripts": {
    "build": "npm run assets:site --workspace pwa && npm run typecheck:only && npm run build:site --workspace pwa",
    "test": "npm run assets:check --workspace pwa && vitest run",
    "test:watch": "npm run assets:check --workspace pwa && vitest",
    "typecheck": "npm run assets:check --workspace pwa && npm run typecheck:only",
    "typecheck:only": "tsc --noEmit && npm run typecheck:only --workspace pwa",
    "lint": "npm run assets:check --workspace pwa && eslint . && npm run typecheck:only",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "icons": "npm run icons --workspace pwa",
    "assets": "npm run assets --workspace pwa",
    "levels": "npm run levels --workspace pwa",
    "dev": "npm run dev --workspace pwa",
    "native": "npm --prefix native start",
    "native:install": "npm --prefix native install",
    "native:bundle": "npm --prefix native run bundle",
    "native:ios": "npm --prefix native run ios",
    "native:ios:device": "npm --prefix native run ios:device",
    "ios:debug": "npm --prefix native run ios:device:debug",
    "native:android": "npm --prefix native run android",
    "preserver:build": "npm run levels",
    "server:build": "node scripts/build-server.mjs",
    "server:start": "npm run server:build && node electron/server-dist/server/main.js",
    "electron:install": "npm --prefix electron install",
    "electron:bundle": "npm --prefix electron run bundle",
    "preelectron": "npm run levels",
    "electron": "npm --prefix electron run start",
    "electron:test": "npm --prefix electron test",
    "electron:dist": "npm --prefix electron run dist",
    "store:metadata": "node scripts/generate-store-metadata.mjs",
    "store:stage": "node scripts/generate-store-metadata.mjs && node scripts/stage-store-screenshots.mjs",
    "store:deliver": "npm run store:stage && npm --prefix native run deliver"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "playwright": "^1.62.0",
    "prettier": "^3.4.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.9",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=24"
  }
}
