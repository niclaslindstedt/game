{
  "name": "game-app",
  "version": "1.0.0",
  "private": true,
  "description": "The deployed game app — a Vite + Preact PWA shell around the engine in ../engine.",
  "type": "module",
  "scripts": {
    "extract": "node scripts/extract-source-data.mjs",
    "dev": "npm run assets:site && npm run extract && vite",
    "build": "npm run assets:site && npm run build:site",
    "build:site": "npm run extract && vite build && npm run library && node scripts/generate-seo.mjs",
    "library": "node scripts/library/build.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "icons": "pwa-assets-generator && node scripts/generate-og.mjs",
    "screenshots": "node scripts/generate-screenshots.mjs",
    "assets": "node ../scripts/generate-content.mjs",
    "assets:site": "node ../scripts/generate-content.mjs --previews=sprites",
    "assets:check": "node ../scripts/generate-content.mjs --previews=none",
    "levels": "node ../scripts/generate-content.mjs --no-assets",
    "map": "node ../scripts/map-preview.mjs",
    "map-layout": "node ../scripts/map-layout.mjs",
    "preview": "vite preview",
    "typecheck": "npm run assets:check && npm run typecheck:only",
    "typecheck:only": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "preact": "^10.29.8",
    "workbox-window": "^7.0.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@vite-pwa/assets-generator": "^1.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.1",
    "yaml": "^2.9.0"
  }
}
