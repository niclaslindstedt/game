<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0

  Hardened-runtime entitlements for the macOS build.

  Apple's hardened runtime is required for notarization, and it switches off
  several things a Chromium-based app cannot run without. Each entry below is
  present because something concrete breaks without it — none is speculative:

    allow-jit / allow-unsigned-executable-memory
      V8 compiles JavaScript to machine code at runtime. Without these the
      renderer cannot start at all.

    disable-library-validation
      The Steam integration loads two libraries that Apple did not sign and
      that are not signed with OUR team id either: steamworks.js' native
      `.node` addon, and Valve's own `libsteam_api.dylib`. Library validation
      refuses both, which surfaces as the game launching with Steam silently
      unavailable rather than as a crash.

    allow-dyld-environment-variables
      Steam launches games with DYLD_* set (it injects the overlay this way).
      Without this the app is killed on launch when started FROM Steam, while
      working perfectly when double-clicked — a confusing failure to debug.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
  </dict>
</plist>
