{
  // Typechecking config. The build config (tsconfig.json) compiles `src/` alone
  // with a `rootDir`, so `dist/` mirrors `src/` and `main` resolves — which
  // means it cannot also cover the tests. This one adds them, emits nothing,
  // and is what `npm run typecheck` uses.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // The build scripts are plain `.mjs` (the repo's convention for tooling),
    // so the tests that import them need TS to read JS. Inference only —
    // `checkJs` stays off, since those files are not written to typecheck.
    "allowJs": true,
    "checkJs": false,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.mts",
    "vitest.config.mts"
  ]
}
